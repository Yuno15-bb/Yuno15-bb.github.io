---
import '../styles/global.css';
import { languages, languageCodes, ui, type Lang } from '../i18n/ui';
import FondAnime from "../components/FondAnime.astro";

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** Chemin equivalent dans l'autre langue, pour le switch (ex: "/projects/dgc-system"). */
  altPath?: string;
  /** Page produit : pas de fond animé, fond opaque au ton demandé (voir styles/produit.css). */
  produit?: 'nuit' | 'jour';
}
const { title, description = '', lang, altPath = '', produit } = Astro.props;

const other: Lang = lang === 'fr' ? 'en' : 'fr';
const t = ui[lang];
// Sur la home : ancre vers la section contact (qui se deplie). Ailleurs : retour home + ancre.
const contactHref = `/${lang}/#contact`;
---
<!doctype html>
<html lang={lang} data-produit={produit}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Icone d'onglet = la photo de profil GitHub (Yuno15-bb), declinee en PNG.
        Le SVG reste en dernier recours pour les navigateurs qui le preferent ;
        les PNG sont listes AVANT, donc choisis en priorite. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="fr" href={`/fr${altPath}`} />
    <link rel="alternate" hreflang="en" href={`/en${altPath}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Page produit : le ton choisi par le visiteur (bouton soleil/lune de l'en-tête) est
        posé AVANT le premier affichage, sinon la page s'afficherait une image dans le ton
        par défaut puis basculerait. Le choix vaut pour toutes les pages produit. */}
    {produit && <script is:inline>try{var t=localStorage.getItem('produit-ton');if(t==='nuit'||t==='jour')document.documentElement.dataset.produit=t}catch(e){}</script>}
  </head>
  <body>
    {/* Le champ d'étoiles a été RETIRÉ le 2026-09-07 : le fond animé le remplace,
        il ne se pose pas dessus. Deux fonds WebGL en même temps, c'étaient aussi
        deux boucles d'animation qui se disputaient la carte graphique. Le composant
        reste dans le dépôt — le remettre tient en une ligne. */}
    {/* Sur une page produit, le contenu est opaque en plein cadre (base Landmarks) : le fond
        animé n'y serait jamais vu, il ne tournerait que pour vider la batterie. */}
    {!produit && <FondAnime />}
    <a class="skip-link" href="#main">{t['skip']}</a>
    <header class="container site-head">
      <a href={`/${lang}/`} class="wordmark" aria-label="Accueil / Home">Yuno<span class="accent">15</span></a>
      <nav class="site-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        {/* LA PHOTO DE PROFIL A ÉTÉ RETIRÉE le 18/09 (Dylan : « la pastille github enlève
            ma photo »). La pastille ne porte plus que la marque, comme celle de LinkedIn :
            les deux destinations se ressemblent enfin, et la barre y gagne 38 px. */}
        <a class="gh gh--seul" href="https://github.com/Yuno15-bb" target="_blank" rel="me noopener noreferrer"
           aria-label="GitHub — Yuno15-bb" title="GitHub — @Yuno15-bb">
          <svg class="gh__mark" viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
        </a>
        {/* LinkedIn a sa propre pastille, pas un troisieme glyphe dans celle de GitHub : deux
            destinations differentes ne partagent pas un lien. Le glyphe est celui de LinkedIn. */}
        <a class="gh gh--seul gh--voisine" href="https://www.linkedin.com/in/elliass-peellaert" target="_blank" rel="me noopener noreferrer"
           aria-label="LinkedIn — Elliass Peellaert" title="LinkedIn — Elliass Peellaert">
          <svg class="gh__mark" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="currentColor">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>
          </svg>
        </a>
        <a class="eyebrow nav-link" href={contactHref}>{t['nav.contact']}</a>
        <a class="lang-switch eyebrow" href={`/${other}${altPath}`} hreflang={other} rel="alternate">
          {/* Le mot entier porte TOUJOURS le nom accessible : sur telephone il passe en
              `sr-only` (il reste lu, il cesse d'etre dessine) et les deux lettres prennent
              sa place a l'ecran. Un seul libelle pour un lecteur d'ecran, jamais deux. */}
          <span class="lang-switch__mot">{languages[other]}</span>
          <span class="lang-switch__code" aria-hidden="true">{languageCodes[other]}</span>
        </a>
        {/* Bascule nuit/jour, sur les pages produit seulement (Dylan, 25/09 : « les 2 couleurs
            possibles avec icône de changement »). L'icône montre le ton ACTUEL, le nom accessible
            dit l'action. Glyphes : Lucide « sun » et « moon », licence ISC. Le clic vit dans
            components/produit/PageProduit.astro. */}
        {produit && (
          <button type="button" class="gh gh--seul bascule-ton"
                  data-libelle-jour={t['ton.sombre']} data-libelle-nuit={t['ton.clair']}
                  aria-label={produit === 'jour' ? t['ton.sombre'] : t['ton.clair']}
                  title={produit === 'jour' ? t['ton.sombre'] : t['ton.clair']}>
            <svg class="gh__mark bascule-ton__lune" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
            <svg class="gh__mark bascule-ton__soleil" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
          </button>
        )}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="container site-foot eyebrow">
      <span>© {new Date().getFullYear()} Elliass Peellaert · Yuno15</span>
      <span>Astro · direction champ spatial</span>
    </footer>

    <style>
      .site-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding-block: var(--space-4);
        /* ⚠ Mesure du 04/09 sur telephone (390 px) : le bord droit du mot-marque
           et le bord gauche de la pastille GitHub tombaient tous les deux a
           136 px — zero espace entre les deux, le nom semblait colle a l'avatar.
           `space-between` ne garantit rien quand la ligne est pleine : il faut un
           ecart minimum, et une nav plus serree pour que tout tienne SUR UNE
           ligne — la faire passer a la ligne rendait l'en-tete deux fois plus
           haut sur un telephone, pour un probleme de 16 px. */
        gap: var(--space-3);
      }
      .wordmark {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--fs-400);
        letter-spacing: var(--tracking-tight);
      }
      .site-nav { display: flex; align-items: center; gap: var(--space-4); }

      .lang-switch__code { display: none; }

      /* GITHUB ET LINKEDIN SE TIENNENT ENSEMBLE (Dylan, 18/09 : « rapproche-la de la
         pastille linkedin »). Ce sont deux portes vers la même personne : l'écart entre
         elles doit être plus court que celui qui les sépare du reste de la barre. 6 px
         contre les 24 de la nav — elles se lisent comme une paire, pas comme deux liens
         posés là. La marge NÉGATIVE annule l'écart de la nav au lieu de le contredire :
         `gap` ne se règle pas élément par élément. */
      .gh--voisine { margin-left: calc(6px - var(--space-4)); }
      /* ⚠ CETTE RÈGLE DOIT RESTER AU-DESSUS DU BLOC TÉLÉPHONE. Écrite en dessous, elle
         écrasait son propre correctif : à spécificité égale, la dernière déclarée gagne,
         media query ou pas. Mesuré le 18/09 — les deux pastilles se CHEVAUCHAIENT de
         16 px sur téléphone alors que la règle d'écart y était bien présente. */

      /* ============================================================
         L'EN-TETE DOIT TENIR SUR LA LARGEUR DU TELEPHONE — mesure du 19/09.
         Le 04/09 on avait choisi de tout garder SUR UNE LIGNE : passer a la
         ligne doublait la hauteur de l'en-tete pour un debordement de 16 px.
         Depuis, la pastille LinkedIn est arrivee (18/09) et le debordement est
         passe a 57 px en anglais : `Yuno15` + photo + GitHub + LinkedIn +
         `Contact` + `English` demandaient 386 px dans une barre qui en offre
         329. Resultat a l'ecran : « ENGLISH » coupe au bord droit, et TOUTE la
         page qui glissait de 15 px sur le cote, sur les quatre pages.
         La decision du 04/09 est tenue — une seule ligne — en RETRECISSANT au
         lieu de retirer : rien ne disparait de la barre.
         ============================================================ */
      @media (max-width: 460px) {
        /* 1. LA LANGUE EN DEUX LETTRES : 77 px -> 28 px. Le plus gros gain, et
           celui qui ne coute rien — c'est la forme habituelle sur telephone. */
        .lang-switch__mot {
          position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
          overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
        }
        .lang-switch__code { display: inline; }

        /* 2. LES ECARTS SE RESSERRENT. 16 px entre quatre elements et 24 px entre
           le nom et la nav, c'est une respiration de bureau : 10 et 12 suffisent a
           separer, et rendent 30 px au contenu. */
        .site-nav { gap: 10px; }
        .site-head { gap: 12px; }

        /* 3. LE MOT-MARQUE D'UN CRAN PLUS BAS. 25 px de haut, il pesait 88 px de
           large a lui seul — plus que la photo et les deux glyphes reunis. A 20 px
           il reste le premier objet de la barre sans en prendre le quart. */
        .wordmark { font-size: var(--fs-300); }

        /* 4. LA PASTILLE GITHUB CESSE D'ETRE ECRASEE. Le flex la comprimait a 43 px
           pour ses 71 px de contenu : le chat GitHub se posait PAR-DESSUS le bord
           droit de la photo (vu sur la capture). `flex: none` lui rend sa taille —
           la place existe maintenant. */
        .gh { flex: none; padding-right: 8px; gap: 6px; }
        .gh--seul { padding-inline: 8px; }
        /* L'écart de la nav tombe à 10 px ici : la marge négative se recalcule dessus,
           sinon les deux pastilles se chevaucheraient. */
        .gh--voisine { margin-left: -6px; }
      }

      /* Photo de profil ronde liée au logo GitHub — vitre légère assortie au reste. */
      .gh {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 4px 10px 4px 4px;
        border-radius: 999px;
        color: var(--c-fg);
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: linear-gradient(158deg, rgba(255,255,255,0.075), rgba(255,255,255,0.02));
        -webkit-backdrop-filter: blur(14px) saturate(1.4);
        backdrop-filter: blur(14px) saturate(1.4);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.16), 0 14px 30px -24px rgba(0,0,0,0.8);
        transition: border-color var(--dur-trans) var(--ease-out),
                    transform var(--dur-trans) var(--ease-out);
      }
      .gh:hover, .gh:focus-visible {
        border-color: color-mix(in srgb, var(--c-ember) 55%, transparent);
        transform: translateY(-1px);
      }
      /* Sans photo, la pastille n'a pas besoin du creux de gauche qui logeait l'avatar. */
      .gh--seul { padding: 7px 10px; }
      .gh__mark { opacity: 0.9; flex: none; }
      .gh:hover .gh__mark { color: var(--c-ember); opacity: 1; }
      @media (prefers-reduced-motion: reduce) { .gh:hover { transform: none; } }
      .nav-link { border-bottom: 1px solid transparent; }
      .nav-link:hover { color: var(--c-accent); border-color: var(--c-accent); }
      .lang-switch { border-bottom: 1px solid transparent; }
      .lang-switch:hover { color: var(--c-accent); border-color: var(--c-accent); }
      main { min-height: 70vh; }
      .site-foot {
        display: flex;
        justify-content: space-between;
        gap: var(--space-3);
        flex-wrap: wrap;
        padding-block: var(--space-8) var(--space-6);
        margin-top: var(--space-12);
        border-top: 1px solid var(--c-line);
      }
    </style>
  </body>
</html>
