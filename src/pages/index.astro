---
// Racine `/` — porte d'entree du site : on part en ANGLAIS.
// Redirection faite a la main plutot que par `redirectToDefaultLocale`, dont le
// meta-refresh a 2 s laisse un ecran blanc au visiteur. Ici : `location.replace`
// des le parse (instantane, et sans polluer l'historique), meta-refresh a 0 s en
// filet si le JS est coupe, et un vrai lien si les deux echouent.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Yuno15 — AI &amp; product engineer</title>
    <meta http-equiv="refresh" content="0;url=/en/" />
    <link rel="canonical" href="/en/" />
    <meta name="robots" content="noindex" />
    <script is:inline>location.replace('/en/');</script>
  </head>
  <body style="background:#0a0b14;color:#e9e7f2;font-family:system-ui,sans-serif;padding:2rem">
    <a href="/en/" style="color:#d8804a">Continue to the site →</a>
  </body>
</html>
