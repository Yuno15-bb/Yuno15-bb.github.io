---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Pile from '../../components/Pile.astro';
import { COMPETENCES, LOGOS } from '../../data/logos.ts';
// Le script est en JavaScript : on déclare ce que LOGOS est vraiment, un dictionnaire
// nom → logo ou rien. (Même raison que dans Pile.astro — `astro check` le refuse sinon.)
const CATALOGUE_LOGOS = LOGOS as Record<string, string | null>;
import { languages, ui, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];

const all = await getCollection('projects');
const projects = all
  .filter((p) => p.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.ordre - b.data.ordre);

// Pastille "Créatif / XR" SUPPRIMÉE le 25/08/2026 : le XR est sorti du
// positionnement, mesure à l'appui (16 commits au total, arrêtés le 27/07
// contre 1533 sur le système de mémoire). Ne pas la remettre sans mesure.
const filters = [
  { key: 'all', label: t['home.filter.all'] },
  { key: 'business', label: t['home.filter.business'] },
] as const;
// Un filtre qui ne filtre RIEN est une promesse cassee : depuis le retrait de la
// pastille XR (25/08), les trois projets portent la meme etiquette, donc les deux
// boutons montraient exactement les memes cartes. On ne les affiche que si les
// projets se repartissent vraiment sur plusieurs publics — le jour ou un second
// public revient, le filtre revient tout seul.
const publics = new Set(projects.flatMap((p) => p.data.audience));
const filtreUtile = publics.size > 1;
/* LA BANDE DE COMPÉTENCES VIENT DU CV, ET SEULEMENT DE CE QUI PORTE UN VRAI LOGO.
   (Dylan, 18/09 : « je doute que les skills citent absolument tout les skills cités dans
   mes profils » et « tout ce qui n'a pas d'icône, enlève-le ».)
   Premier jet : l'union des piles des deux études de cas. C'était vrai mais partiel — ni
   React, ni TypeScript, ni Playwright, ni pytest, ni Git, ni Railway, ni Sentry n'y
   étaient, alors qu'ils sont tous dans le CV.
   Le filtre sur `LOGOS[nom]` rend la seconde consigne MÉCANIQUE : une compétence sans
   marque ne peut pas entrer, même ajoutée par distraction dans la liste. La liste et le
   catalogue vivent côte à côte dans scripts/logos-de-la-pile.mjs. */
const competences = COMPETENCES.filter((nom) => CATALOGUE_LOGOS[nom]);

const email = 'sashapeellaertjuan@outlook.com';
const mail = `mailto:${email}`;
---
<Base title={`Yuno15 — ${t['site.role']}`} description={t['home.intro']} lang={lang} altPath="/">
  {/* Garde progressive : n'arme l'intro que si JS + pas de reduced-motion. Failsafe 1.6s. */}
  <script is:inline>
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var el = document.documentElement;
      el.setAttribute('data-hero', 'armed');
      setTimeout(function () {
        if (el.getAttribute('data-hero') === 'armed') el.setAttribute('data-hero', 'done');
      }, 1600);
    })();
  </script>

  <section class="hero" id="hero">
    <div class="intro-wipe" aria-hidden="true"></div>
    <div class="container hero__inner">
      {/* Le bloc de texte repose sur une vitre (liquid glass) : elle floute le fond WebGL
          derrière elle → lisibilité + profondeur, même langage que les cartes projet. */}
      <div class="hero__panel">
        {/* Decision du 25/08/2026 : nom civil affiche, Yuno15 conserve comme
            marque. Un recruteur doit pouvoir relier le site a une personne. */}
        <p class="hero__name anim-in">Elliass Peellaert</p>
        <p class="hero__eyebrow anim-in">{t['site.role']}</p>
        <h1 class="anim-in" id="hero-title">{t['home.intro']}</h1>
        {/* LE SOUS-TITRE A ÉTÉ SUPPRIMÉ le 18/09, sur demande de Dylan (« two products
            running for a real client… , supprime »). Il annonçait deux produits en
            production chez un vrai client depuis mai 2026 ; les deux études de cas le
            disent déjà, chiffres à l'appui, et le titre n'a pas besoin qu'on le double.
            Ne pas le remettre sans lui. */}
        <a class="btn hero__cta anim-in" href={mail}>{t['cta.contact']} →</a>
      </div>
    </div>
  </section>

  {/* Dylan, 18/09 : « je veux la même chose mais avec leurs vrais logos posés comme des
      badges, ou différemment qui défile dans un petit panneau ». Les pages projet ont eu
      les badges posés ; l'accueil reçoit le panneau qui défile, avec l'ensemble de ce que
      les projets emploient. Il se place après le hero et avant les projets : on vient de
      lire QUI, on lit AVEC QUOI, puis on entre dans les preuves. */}
  <section class="container competences" aria-label={t['home.stack']}>
    <Pile items={competences} titre={t['home.stack']} bandeau />
  </section>

  <section class="container work" aria-labelledby="work-title">
    <div class="work__head">
      <h2 id="work-title">{t['home.work.title']}</h2>
      {filtreUtile && (
        <div class="filter" role="group" aria-label={t['home.filter.label']}>
          {filters.map((f, i) => (
            <button class="filter__btn" type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
            </button>
          ))}
        </div>
      )}
    </div>

    <ul role="list" class="grid work__grid" id="project-grid">
      {projects.map((p) => (
        <li class="work__item" data-audience={p.data.audience.join(' ')}>
          <ProjectCard
            lang={lang}
            slug={p.id.split('/')[1]}
            titre={p.data.titre}
            pitch={p.data.pitch}
            audience={p.data.audience}
            annee={p.data.annee}
            cover={p.data.cover}
            cover2={p.data.cover2}
            coverEntier={p.data.coverEntier}
            tilt={p.data.cover ? 2.5 : 0}
          />
        </li>
      ))}
    </ul>
    <p class="empty-state" id="empty-state" hidden>{t['home.empty']}</p>
  </section>

  <section class="container contact" aria-labelledby="contact-title" id="contact">
    <h2 id="contact-title">{t['home.contact.title']}</h2>
    <p class="contact__body">{t['home.contact.body']}</p>

    {/* Panneau qui se deplie reellement (accordeon accessible), au lieu d'un mailto muet. */}
    <button
      class="btn btn--primary"
      type="button"
      id="contact-toggle"
      aria-expanded="false"
      aria-controls="contact-panel"
    >
      <span data-label-open>{t['cta.contact']}</span>
      <span class="contact__chev" aria-hidden="true">▾</span>
    </button>

    <div class="contact__panel" id="contact-panel" hidden>
      <div class="contact__inner">
        <p class="eyebrow">{t['contact.email']}</p>
        <div class="contact__row">
          <a class="contact__mail" href={mail}>{email}</a>
          <button
            class="btn contact__copy"
            type="button"
            id="contact-copy"
            data-copy={email}
            data-copied={t['contact.copied']}
          >
            {t['contact.copy']}
          </button>
        </div>
        <p class="contact__status eyebrow" id="contact-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <style>
    /* Hero — direction « champ spatial » : AUCUNE boite. Le texte pose
       directement sur le champ de particules, tenu par un filet et du vide.
       C'est la mise en page qui porte, plus un contenant. */
    .hero { position: relative; margin-bottom: var(--space-12); }
    .hero__inner { position: relative; padding-block: var(--space-8) var(--space-12); }

    .hero__panel {
      position: relative;
      display: grid;
      justify-items: center;
      text-align: center;
      max-width: 62ch;
      margin-inline: auto;
      /* Composition centree : le filet de gauche n'a plus de colonne a aligner,
         il devient un trait court AU-DESSUS, sur l'axe. Meme discipline suisse
         (une structure minimale, pas un contenant), axe vertical au lieu de
         l'axe gauche. */
      padding-top: var(--space-4);
    }
    .hero__panel::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      width: 1px;
      height: var(--space-4);
      background: var(--c-line-ui);
      transform: translateX(-50%);
    }
    .hero__name {
      font-family: var(--font-display, var(--font-serif, serif));
      font-size: var(--fs-300);
      color: var(--c-fg);
      letter-spacing: -0.01em;
      margin-bottom: var(--space-2);
    }
    .hero__eyebrow {
      font-family: var(--font-mono);
      font-size: var(--fs-100);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--c-ember);
    }
    /* Type-as-image : le titre EST la composition. Plus rien ne le contient. */
    .hero h1 {
      font-size: clamp(var(--fs-500), 3.6vw, var(--fs-700));
      max-width: 20ch;
      /* `p`/`h1` heritent d'un max-width global : sans margin-inline auto le texte
         serait centre DANS une boite restee a gauche. */
      margin-inline: auto;
      margin-top: var(--space-3);
      color: var(--c-fg);
    }
    .hero__cta {
      /* DESCENDU d'un cran le 18/09 (Dylan : « redescend un peu le bouton »). Le titre
         n'a plus de sous-titre sous lui depuis le même jour : le bouton remontait juste
         sous la dernière ligne et se collait à elle. --space-8 lui rend le vide que le
         sous-titre occupait. */
      margin-top: var(--space-8);
      background: var(--c-ember); color: var(--c-accent-ink); border-color: var(--c-ember);
      font-weight: 600;
    }
    .hero__cta:hover { background: transparent; color: var(--c-ember); border-color: var(--c-ember); }

    /* Wipe d'intro : voile clair sur le champ orage. Cachee par defaut (no-JS safe). */
    .intro-wipe {
      position: absolute; inset: 0; z-index: 5;
      background: var(--c-fg);
      transform: scaleY(0); transform-origin: top;
      pointer-events: none;
    }
    /* LES TROIS CARRÉS DÉCORATIFS ONT ÉTÉ SUPPRIMÉS le 18/09 (Dylan : « supprime les
       3 carré de couleurs »). Ils étaient posés en haut à droite du hero et n'étaient
       déjà affichés que sur grand écran. Ne pas les remettre sans lui. */

    /* Pre-masquage anti-flash : uniquement quand l'intro est armee. */
    :global(:root[data-hero='armed']) .anim-in { opacity: 0; }

    /* La bande ne crie pas : elle vit entre le hero et les projets, sans filet ni fond.
       Le hero se termine déjà par --space-12 de vide ; on ne le double pas. */
    .competences { margin-bottom: var(--space-8); }

    .work__head {
      display: flex; align-items: end; justify-content: space-between;
      gap: var(--space-3); flex-wrap: wrap;
      padding-bottom: var(--space-4); margin-bottom: var(--space-4);
      border-bottom: 1px solid var(--c-line);
    }
    .work__grid { row-gap: var(--space-4); }
    /* span en CSS (pas inline) : Flip clearProps ne doit rien casser au layout */
    /* `display: grid` sur l'element de liste : sans lui, la carte garde sa
       hauteur de contenu et ne remplit pas la rangee — la fleche ne peut donc
       pas se caler en bas. */
    .work__item { grid-column: span 6; display: grid; }

    /* Section contact resserrée : elle ne doit pas peser autant qu'une section de projets. */
    .contact {
      margin-top: var(--space-8);
      display: grid; gap: var(--space-2); justify-items: start;
    }
    .contact h2 { font-size: clamp(var(--fs-300), 2vw, var(--fs-500)); }
    .contact__body {
      color: var(--c-muted);
      font-size: var(--fs-200);
      max-width: 48ch;
    }
    .contact .btn { margin-top: var(--space-1); }
    .contact__chev { transition: transform var(--dur-micro) var(--ease-out); }
    #contact-toggle[aria-expanded='true'] .contact__chev { transform: rotate(180deg); }

    /* Panneau depliant : hauteur animee par GSAP, mais utilisable sans JS (hidden retire). */
    .contact__panel { overflow: hidden; width: 100%; }
    .contact__inner {
      display: grid; gap: var(--space-2);
      padding: var(--space-4);
      border: 1px solid var(--c-line);
      background: var(--c-surface);
      max-width: 34rem;
    }
    .contact__row { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .contact__mail {
      font-family: var(--font-mono);
      font-size: var(--fs-300);
      color: var(--c-fg);
      border-bottom: 1px solid var(--c-line);
    }
    .contact__mail:hover { color: var(--c-ember); border-color: var(--c-ember); }
    .contact__copy { padding: 0.45em 0.9em; }
    .contact__status { color: var(--c-ember); min-height: 1.2em; }

    @media (max-width: 720px) {
      .work__grid > li { grid-column: 1 / -1 !important; }
    }
  </style>

  <script>
    // Hero cinetique (moment fort) — GSAP, 100% code. Progressive enhancement :
    // ne s'execute que si l'intro a ete armee (JS + pas de reduced-motion).
    import gsap from 'gsap';
    import { SplitText } from 'gsap/SplitText';

    const root = document.documentElement;
    if (root.getAttribute('data-hero') === 'armed') {
      const q = (s: string) => document.querySelector<HTMLElement>(s);
      const wipe = q('.intro-wipe');
      const eyebrow = q('.hero__eyebrow');
      const title = q('#hero-title');
      const cta = q('.hero__cta');

      gsap.set(cta, { opacity: 0, y: 24 });

      // Révélation CARACTÈRE PAR CARACTÈRE (machine à écrire) sur l'eyebrow
      // et le titre. SplitText est reverté à la fin : le texte
      // redevient du texte normal (sélectionnable, lisible aux lecteurs d'écran).
      const splits: SplitText[] = [];
      const charsOf = (el: HTMLElement | null): Element[] => {
        if (!el) return [];
        try {
          // 'words,chars' et PAS 'chars' seul : sinon les mots peuvent être coupés
          // en fin de ligne, le retour à la ligne diffère de l'original, et le texte
          // SAUTE au moment du revert. Avec les mots, la césure reste identique.
          const s = new SplitText(el, { type: 'words,chars' });
          splits.push(s);
          gsap.set(el, { opacity: 1 });
          gsap.set(s.chars, { opacity: 0 });
          return s.chars;
        } catch {
          gsap.set(el, { opacity: 0 });
          return [el];
        }
      };

      let cEyebrow: Element[] = [], cTitle: Element[] = [];
      try {
        gsap.registerPlugin(SplitText);
        cEyebrow = charsOf(eyebrow);
        cTitle = charsOf(title);
      } catch {
        gsap.set([eyebrow, title], { opacity: 0 });
        cEyebrow = eyebrow ? [eyebrow] : [];
        cTitle = title ? [title] : [];
      }

      root.setAttribute('data-hero', 'playing');

      gsap.timeline({
        defaults: { ease: 'none' },
        onComplete: () => {
          root.setAttribute('data-hero', 'done');
          splits.forEach((s) => s.revert());
        },
      })
        .set(wipe, { scaleY: 1, transformOrigin: 'bottom' })
        .to(wipe, { scaleY: 0, transformOrigin: 'top', duration: 0.5, ease: 'power4.inOut' })
        // chaque caractère apparaît l'un après l'autre — cadence posée, lisible
        .to(cEyebrow, { opacity: 1, duration: 0.01, stagger: 0.035 }, '-=0.2')
        .to(cTitle, { opacity: 1, duration: 0.01, stagger: 0.024 }, '-=0.05')
        .to(cta, { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' }, '-=0.1');
    }
  </script>

  <script>
    // L3 — filtre accessible avec Flip (le layout anime le vrai changement DOM)
    // + reveals au scroll (ScrollTrigger). Reduced-motion => bascule instantanée.
    import gsap from 'gsap';
    import { Flip } from 'gsap/Flip';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const grid = document.getElementById('project-grid');
    const empty = document.getElementById('empty-state');
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter__btn'));

    if (grid && empty) {
      const items = Array.from(grid.querySelectorAll<HTMLLIElement>('.work__item'));
      const apply = (key: string) => {
        let visible = 0;
        items.forEach((li) => {
          const show = key === 'all' || (li.dataset.audience ?? '').split(' ').includes(key);
          li.hidden = !show;
          if (show) visible++;
        });
        empty.hidden = visible !== 0;
      };
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.filter ?? 'all';
          btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          if (reduce) { apply(key); return; }
          gsap.registerPlugin(Flip);
          const state = Flip.getState(items);
          apply(key);
          Flip.from(state, {
            duration: 0.42,
            ease: 'power3.out',
            absolute: true,
            onEnter: (els) => gsap.fromTo(els, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.35 }),
            onLeave: (els) => gsap.to(els, { opacity: 0, duration: 0.2 }),
            // Flip absolute pose des styles inline (position/width) : on nettoie en fin,
            // sinon les cartes réapparaissent écrasées (bug vu en test réel).
            onComplete: () => gsap.set(items, { clearProps: 'all' }),
          });
        });
      });
    }

    // Panneau contact depliant (remplace le mailto muet). Accordeon accessible.
    const toggle = document.getElementById('contact-toggle');
    const panel = document.getElementById('contact-panel');
    const copyBtn = document.getElementById('contact-copy');
    const status = document.getElementById('contact-status');

    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        if (open) {
          if (reduce) { panel.hidden = true; return; }
          gsap.to(panel, {
            height: 0, opacity: 0, duration: 0.3, ease: 'power2.in',
            onComplete: () => { panel.hidden = true; gsap.set(panel, { clearProps: 'all' }); },
          });
        } else {
          panel.hidden = false;
          if (reduce) return;
          gsap.fromTo(panel,
            { height: 0, opacity: 0 },
            { height: 'auto', opacity: 1, duration: 0.42, ease: 'power3.out',
              onComplete: () => gsap.set(panel, { clearProps: 'height' }) });
        }
      });
    }

    if (copyBtn && status) {
      copyBtn.addEventListener('click', async () => {
        const value = copyBtn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
          status.textContent = copyBtn.dataset.copied ?? '';
        } catch {
          // Presse-papier refuse (http, permission) : on selectionne l'adresse a la place.
          const mailEl = document.querySelector<HTMLElement>('.contact__mail');
          if (mailEl) {
            const range = document.createRange();
            range.selectNodeContents(mailEl);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
          status.textContent = value;
        }
      });
    }

    // Reveals au scroll — une fois, sobres (opacity+y), jamais porteurs d'info seuls.
    if (!reduce) {
      gsap.registerPlugin(ScrollTrigger);
      gsap.utils.toArray<HTMLElement>('.work__item, .contact > *').forEach((el) => {
        gsap.fromTo(el, { opacity: 0, y: 28 }, {
          opacity: 1, y: 0, duration: 0.55, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        });
      });
    }
  </script>
</Base>
