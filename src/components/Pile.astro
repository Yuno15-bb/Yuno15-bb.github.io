---
/**
 * Pile — les technologies d'un projet, en badges avec leur VRAI logo.
 *
 * Dylan, 2026-09-18 : « à la place de [la liste de texte] je veux la même chose mais avec leurs
 * vrais logos qui sont posés comme des badges, et je les veux sous le titre, pour tous les projets ».
 *
 * CE QUE ÇA ROUVRE, ET POURQUOI C'EST TENABLE. Le 2026-09-07, la pile avait été DESCENDUE en bas
 * de page : en texte, elle prenait un tiers du premier écran, et le premier fait retenu d'une
 * étude de cas était une liste d'outils au lieu d'une contrainte. Le reproche visait la PLACE
 * qu'elle prenait, pas le fait d'être là. En badges, la même pile tient sur une ou deux lignes
 * dans la colonne laissée libre entre « rôle » et « résultat » — elle se lit d'un coup d'œil
 * au lieu de se lire mot à mot.
 *
 * LES LOGOS SONT LES VRAIS, ET SEULEMENT LES VRAIS. Ils viennent de Simple Icons (CC0), copiés
 * dans public/logos/ par scripts/logos-de-la-pile.mjs. Une technologie qui n'est pas une marque
 * — « Service Worker », « RLS », « GPS », « PDF » — sort en texte seul : on ne dessine pas un
 * faux logo pour boucher un trou.
 *
 * Le SVG est posé en <img> et recoloré par masque CSS : le fichier reste un seul fichier, et le
 * badge suit la couleur du texte sans qu'on duplique un logo par état.
 */
import { LOGOS } from '../data/logos.ts';
// Le script est en JavaScript : TypeScript en deduit un objet aux clefs figees, et refuse
// qu'on l'interroge avec un nom venu du contenu. On declare ce qu'il est vraiment — un
// dictionnaire nom → logo, ou rien. (`astro check` l'a refuse le 18/09 ; `astro build`, non.)
const CATALOGUE = LOGOS as Record<string, string | null>;

interface Props {
  items: string[];
  titre: string;
  /** true : le bloc défile tout seul horizontalement quand il déborde (petits écrans). */
  defilant?: boolean;
  /**
   * BANDEAU QUI DÉFILE TOUT SEUL — demandé par Dylan le 18/09 (« ou différemment qui
   * défile dans un petit panneau »), posé sur l'accueil le 19/09. La piste est écrite
   * DEUX FOIS bout à bout et translatée de sa moitié : quand l'animation reboucle, la
   * seconde copie est exactement là où était la première, et la couture ne se voit pas.
   * La copie est `aria-hidden` — un lecteur d'écran lit la liste une fois, pas deux.
   */
  bandeau?: boolean;
}
const { items, titre, defilant = true, bandeau = false } = Astro.props;
const badges = items.map((nom) => ({ nom, slug: CATALOGUE[nom] ?? null }));
---

<div class:list={['pile', { 'pile--defilante': defilant && !bandeau, 'pile--bandeau': bandeau }]}>
  <p class="eyebrow pile__titre">{titre}</p>
  {bandeau ? (
    <div class="pile__cadre">
      <div class="pile__piste">
        <ul class="pile__liste" role="list">
          {badges.map(({ nom, slug }) => (
            <li class:list={['pile__badge', { 'pile__badge--nu': !slug }]}>
              {slug && <span class="pile__logo" style={`-webkit-mask-image:url(/logos/${slug}.svg);mask-image:url(/logos/${slug}.svg)`} aria-hidden="true" />}
              <span>{nom}</span>
            </li>
          ))}
        </ul>
        <ul class="pile__liste" role="list" aria-hidden="true">
          {badges.map(({ nom, slug }) => (
            <li class:list={['pile__badge', { 'pile__badge--nu': !slug }]}>
              {slug && <span class="pile__logo" style={`-webkit-mask-image:url(/logos/${slug}.svg);mask-image:url(/logos/${slug}.svg)`} aria-hidden="true" />}
              <span>{nom}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  ) : (
    <ul class="pile__liste" role="list">
      {badges.map(({ nom, slug }) => (
        <li class:list={['pile__badge', { 'pile__badge--nu': !slug }]}>
          {slug && <span class="pile__logo" style={`-webkit-mask-image:url(/logos/${slug}.svg);mask-image:url(/logos/${slug}.svg)`} aria-hidden="true" />}
          <span>{nom}</span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .pile { min-width: 0; }
  .pile__titre { margin: 0 0 0.6rem; }

  .pile__liste {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .pile__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-size: var(--fs-100);
    line-height: 1.2;
    color: var(--c-text);
    white-space: nowrap;
    /* Le verre ne va que sur la navigation et les commandes, jamais sur le contenu : ici, un
       simple voile sombre, pas de flou. */
    background: rgb(255 255 255 / 0.03);
  }

  /* Sans logo : le badge se distingue, on ne fait pas croire qu'il en manque un. */
  .pile__badge--nu { color: var(--c-muted); border-style: dashed; }

  .pile__logo {
    width: 1em;
    height: 1em;
    /* ⚠ 1em = la taille du texte du badge. La bande de l'accueil, elle, double (voir
       `.pile--bandeau .pile__logo` plus bas) : sur les pages projet le logo accompagne
       un nom, sur l'accueil c'est LUI qu'on reconnaît en passant. */
    flex: none;
    background: currentColor;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  /* ⚠ LE DEFILEMENT HORIZONTAL A ETE RETIRE SUR TELEPHONE — mesure du 19/09.
     L'idee de depart : quand la place manque, la pile defile a l'horizontale au lieu de
     pousser la page vers le bas. Mesure a 393 px : sur GreyMatter 4 badges sur 7 etaient
     visibles, sur Field Ops 5 sur 13. Les huit autres — « GitHub Actions », « Apache 2.0 »,
     « FastAPI »… — se trouvaient HORS DE L'ECRAN, derriere un badge coupe en deux au bord
     droit, sans barre, sans ombre, sans fleche : rien ne disait qu'il fallait balayer.
     Une pile de technologies sert a etre lue d'un coup d'oeil ; celle-la cachait les deux
     tiers de ce qu'elle annonçait.
     Le repli coute quatre lignes, soit environ 150 px sur une page qui en fait 20 000 : le
     prix qu'on evitait etait negligeable, le defaut qu'il creait ne l'etait pas.
     La propriete `defilant` reste, elle ne change plus rien sur telephone. */

  /* ============================================================
     LE BANDEAU QUI DÉFILE — accueil, posé le 19/09.
     Deux bandeaux réels mesurés le même jour à 1440 px, pour ne pas inventer les
     valeurs : Sentry fait 64 px de haut, 46 logos de 30 px, une piste de 8 607 px
     parcourue en 60 s, soit 143 px/s. Prisma fait 38 px de haut, 68 logos de 25 px,
     12 279 px en 100 s, soit 123 px/s. Resend, lui, ne fait PAS défiler : treize
     logos de 30 px posés sur une ligne fixe. Les trois sont en monochrome — c'est ce
     qui fait lire la bande comme un seul objet au lieu d'un arc-en-ciel ; nos badges
     le sont déjà, le logo suit la couleur du texte par masque.
     On prend 55 px/s : les nôtres portent un NOM à côté du logo, et un mot qui défile se
     lit moins vite qu'un sigle (posé à 100, ramené à 55 le 18/09 sur demande de Dylan).
     La durée n'est pas écrite ici : elle est calculée au chargement depuis la largeur
     réelle de la piste (script en bas), sinon la vitesse changerait avec le nombre de
     badges et avec la largeur de l'écran.
     ============================================================ */
  .pile--bandeau { min-width: 0; }

  /* LES LOGOS DE LA BANDE SONT DEUX FOIS PLUS GRANDS (Dylan, 18/09 : « tu peux agrandir
     les icônes x2 sur l'accueil »). Ils passent de 1em à 2em, soit de 14 à 28 px de haut
     — on rejoint les bandeaux mesurés le même jour, où le logo fait 25 px chez Prisma et
     30 chez Sentry. Le badge grandit avec, et c'est voulu : une bande qui défile se
     reconnaît au logo avant de se lire au mot. Les pages projet ne bougent pas, leur pile
     est une liste qu'on lit, pas une bande qu'on aperçoit. */
  .pile--bandeau .pile__logo { width: 2em; height: 2em; }
  .pile--bandeau .pile__badge { padding: 0.35rem 0.8rem; gap: 0.55rem; }

  /* Le cadre coupe, et fond aux deux bords : sans ce dégradé, un badge est tranché net
     au ras de l'écran et la bande a l'air cassée plutôt qu'infinie. */
  .pile__cadre {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .pile__piste {
    display: flex;
    width: max-content;
    gap: 0.4rem;
    animation: pile-defile var(--pile-duree, 40s) linear infinite;
  }
  /* Le survol suspend : on ne court pas après une étiquette qu'on veut lire. */
  .pile__cadre:hover .pile__piste,
  .pile__cadre:focus-within .pile__piste { animation-play-state: paused; }
  .pile--bandeau .pile__liste { flex-wrap: nowrap; }

  @keyframes pile-defile {
    from { transform: translate3d(0, 0, 0); }
    /* La piste porte deux copies : reculer d'exactement la moitié ramène la seconde
       là où était la première. La couture ne se voit pas. */
    to { transform: translate3d(calc(-50% - 0.2rem), 0, 0); }
  }

  /* « Réduire les animations » : la bande s'arrête et se replie sur plusieurs lignes.
     Refuser le mouvement ne doit pas coûter le contenu — tout reste lisible, d'un coup. */
  @media (prefers-reduced-motion: reduce) {
    .pile__cadre {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .pile__piste { animation: none; width: auto; flex-wrap: wrap; }
    .pile--bandeau .pile__liste { flex-wrap: wrap; }
    .pile--bandeau .pile__liste[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  /* LA VITESSE EST CONSTANTE, PAS LA DURÉE. Une durée écrite en dur ferait défiler une
     pile de six badges au ralenti et une pile de dix-huit en trombe, et changerait de
     vitesse à chaque largeur d'écran. On mesure la piste et on en déduit le temps :
     55 px par seconde. Première valeur posée à 100, sous les bandeaux de Sentry (143) et
     de Prisma (123) mesurés le 18/09 — Dylan, le même soir : « ralentis le défilement ».
     Nos badges ne sont pas des sigles : ils portent un NOM à lire, et la bande n'est pas
     une bannière de clients qu'on parcourt du coin de l'œil, c'est une liste qu'on lit.
     À 55, un badge reste dans le champ deux fois plus longtemps.
     `ResizeObserver` refait le calcul quand la largeur change — rotation du téléphone,
     fenêtre redimensionnée, police qui arrive après coup. */
  const VITESSE = 55; // px/s

  const regler = (piste: HTMLElement) => {
    const moitie = piste.scrollWidth / 2;
    if (moitie > 0) piste.style.setProperty('--pile-duree', `${(moitie / VITESSE).toFixed(1)}s`);
  };

  document.querySelectorAll<HTMLElement>('.pile--bandeau .pile__piste').forEach((piste) => {
    regler(piste);
    /* Les polices arrivent après le premier rendu et changent la largeur des étiquettes. */
    if (document.fonts?.ready) document.fonts.ready.then(() => regler(piste));
    new ResizeObserver(() => regler(piste)).observe(piste);
  });
</script>
