  }

  /* Reduced-motion : les ecrans s'empilent, aucun effet de profondeur. */
  @media (prefers-reduced-motion: reduce) {
    .deck { display: grid; grid-template-columns: 1fr; gap: var(--space-6); min-height: 0; }
