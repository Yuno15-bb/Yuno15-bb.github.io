---
/**
 * Duo — deux colonnes qui s'opposent : ce qui est permis / ce qui ne l'est pas,
 * avant / apres, ce qu'on ecrit / ce qu'on n'ecrit pas.
 *
 * Le filet est en HAUT de la colonne, comme sur les étapes de Flow : 1 px neutre,
 * 2 px ember quand la colonne porte l'accent. Une seule des deux colonnes peut le
 * porter — sinon plus rien ne ressort. Il était à gauche de chaque ligne jusqu'au
 * 25/09 : c'est le liseré vertical coloré que Dylan a banni le 09/09.
 */
interface Colonne {
  titre: string;
  items: string[];
}
interface Props {
  a: Colonne;
  b: Colonne;
  /** Colonne qui porte l'accent ember. Par defaut : la seconde. */
  accent?: 'a' | 'b';
}
const { a, b, accent = 'b' } = Astro.props;
const cols: Array<[Colonne, boolean]> = [
  [a, accent === 'a'],
  [b, accent === 'b'],
];
---
<div class="duo">
  {cols.map(([col, fort]) => (
    <section class:list={['duo__col', fort && 'duo__col--fort']}>
      <h4 class="duo__titre eyebrow">{col.titre}</h4>
      <ul role="list" class="duo__list">
        {col.items.map((it) => <li class="duo__item">{it}</li>)}
      </ul>
    </section>
  ))}
</div>

<style>
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .duo__col { border-top: 1px solid var(--c-line-ui); padding-top: var(--space-2); }
  .duo__col--fort { border-top-width: 2px; border-top-color: var(--c-ember); padding-top: calc(var(--space-2) - 1px); }
  .duo__titre { color: var(--c-muted); margin-bottom: var(--space-3); }
  .duo__col--fort .duo__titre { color: var(--c-ember); }
  .duo__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .duo__item {
    color: var(--c-muted);
    font-size: var(--fs-200);
    line-height: 1.5;
  }
  .duo__col--fort .duo__item { color: var(--c-fg); }
  @media (max-width: 760px) {
    .duo { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
