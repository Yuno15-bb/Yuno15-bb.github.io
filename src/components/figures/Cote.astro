---
/**
 * Cote — deux colonnes côte à côte, une large et une étroite.
 *
 * POURQUOI. Une capture de bureau et un petit objet de bureau ne se lisent pas
 * l'un SOUS l'autre : la page s'étire, et le petit objet, seul sur toute la
 * largeur, a l'air perdu. Posés côte à côte ils se répondent — l'écran d'un côté,
 * ce qui se pose par-dessus de l'autre, avec son explication dessous.
 *
 * Sous 900 px il n'y a plus de « à côté » : les colonnes s'empilent, la large
 * d'abord. Une grille à deux colonnes tenue de force sur un téléphone donne deux
 * colonnes illisibles au lieu d'une lisible.
 */
interface Props {
  /** Part de la colonne large. 1.75 : l'écran domine sans manger la planche —
      à 2.2 la carte était trop grande et l'objet d'à côté paraissait accessoire. */
  poids?: number;
}
const { poids = 1.6 } = Astro.props;
---
<div class="cote" style={`--cote-poids:${poids}fr`}>
  <div class="cote__large"><slot name="large" /></div>
  <div class="cote__etroit"><slot name="etroit" /></div>
</div>

<style>
  .cote {
    display: grid;
    grid-template-columns: minmax(0, var(--cote-poids, 1.75fr)) minmax(0, 1fr);
    /* ⚠ ÉTAIT `--space-5`, UN JETON QUI N'EXISTE PAS (échelle : 1,2,3,4,6,8,12).
       La déclaration était invalide, donc jetée : les deux colonnes se touchaient à
       1 px près — mesuré le 2026-09-07. L'écart qu'on croyait voir ne venait que de
       l'objet, plus étroit que sa colonne. */
    gap: var(--space-6);
    align-items: stretch;
  }
  .cote__etroit {
    display: flex;
    flex-direction: column;
    /* LE GROUPE ENTIER — objet + légende — EST CENTRÉ sur l'écran d'à côté.
       Avant, seul l'objet l'était, calé dans la rangée du milieu d'une grille à trois
       rangées. Ça tenait tant que l'objet restait petit ; la fenêtre de la capsule est
       montée à 404 px et la colonne a dû grandir à 562 px pour loger la légende, là où
       l'écran d'à côté en fait 510. Tout a glissé : fenêtre 26 px sous le centre de la
       carte, légende débordant de 24 px sous la colonne (mesuré le 2026-09-07). Le
       groupe fait 475 px, il tient dans les 510 de la carte, et c'est la carte qui
       redonne sa hauteur à la planche. */
    justify-content: center;
    gap: var(--space-2);
    /* UN SEUL BLOC, centré dans la colonne. L'objet et son texte partagent la même
       largeur : l'objet se centre dedans, le texte s'aligne à gauche dedans, donc
       les deux ont exactement le même axe. Sans cette largeur commune, l'objet
       (centré par ses marges automatiques) dérivait à droite du texte — 250 px
       d'écart, vus par Dylan le 2026-09-07. */
    align-items: center;
    height: 100%;
  }
  /* L'objet en tête du groupe, son explication juste en dessous.
     LARGEUR COMMUNE EN REM, PAS EN CH. Un « ch » dépend de la police de CHAQUE
     élément : la légende écrit en var(--fs-100), l'objet hérite du corps de texte,
     donc les mêmes 34ch valaient 340 px pour l'un et 272 px pour l'autre — le cadre
     débordait de 34 px à gauche du texte. Le rem, lui, ne dépend que de la racine :
     les deux mesurent exactement pareil.
     21rem = 302 px dans une colonne qui en offre 465. La borne haute est 27.5rem —
     au-delà, le groupe ne tient plus dans les 510 px de l'écran d'à côté et le
     centrage saute. Mais la borne haute n'est pas la bonne valeur : à 396 px la
     capsule pesait autant que la carte, alors qu'elle est l'objet SECONDAIRE de la
     planche (Dylan, 2026-09-07 : « elle est énorme !! »). À 302 px elle fait 41 %
     de la largeur de la carte — un objet posé à côté d'un écran, pas un second
     écran. */
  .cote__etroit :global(> *) { width: 100%; max-width: 21rem; }
  /* Le texte de la colonne étroite est une légende, pas du corps de texte :
     même traitement que la légende d'une planche, sinon il se lit comme un
     paragraphe de l'article et vole la vedette à l'écran d'à côté. */
  .cote__etroit :global(p) {
    margin: 0;
    color: var(--c-muted);
    font-size: var(--fs-100);
    line-height: 1.5;
    text-align: left;
  }
  /* ENTRE 900 ET 1200 px, l'objet doit maigrir. Les deux colonnes restent côte à
     côte mais l'écran de gauche rétrécit avec la fenêtre, alors que l'objet, borné
     en rem, ne bouge pas : il grossit donc EN PROPORTION, et son groupe finit par
     dépasser la hauteur de l'écran d'à côté. Mesuré à 1024 px : la légende tombait
     40 px sous le bas de la carte. À 16rem le groupe repasse dessous. */
  @media (max-width: 1200px) and (min-width: 901px) {
    .cote__etroit :global(> *) { max-width: 16rem; }
  }
  @media (max-width: 900px) {
    .cote { grid-template-columns: 1fr; gap: var(--space-4); }
    /* Empilé, « au milieu de la carte » n'a plus de sens : l'objet reprend sa
       place normale, en tête de sa propre colonne. */
    .cote__etroit { justify-content: flex-start; align-items: flex-start; height: auto; }
    /* ET IL REDEVIENT SECONDAIRE. Empilés, les deux cadres prennent la même largeur ;
       mais la carte est panoramique et la capsule presque carrée, donc à largeur
       égale la capsule paraît PLUS GROSSE — mesuré à 390 px : 356 px de haut contre
       241 pour la carte. La hiérarchie du bureau s'inversait sur téléphone. À 74 %
       de la colonne, l'objet reprend sa place de commentaire — et 74 % est le plancher
       mesuré : en dessous, « c-brain — capsule » (100 px) ne tient plus dans la place
       laissée par les feux et se fait couper. */
    .cote__etroit :global(> *:first-child) { max-width: 74%; }
  }
</style>
