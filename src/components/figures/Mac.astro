---
/**
 * Mac — la fenêtre macOS, autour de n'importe quel contenu.
 *
 * Extrait d'Ecrans.astro pour pouvoir encadrer autre chose qu'une image : une
 * maquette d'interface reconstruite, par exemple. Applique la règle permanente
 * du 04/09 — une capture ou une maquette de présentation se montre TOUJOURS dans
 * un vrai cadre d'appareil.
 */
interface Props {
  titre?: string;
  clair?: boolean;
  /** Marge noire autour du contenu, en % de la largeur de la fenêtre. Pour un PETIT
      objet filmé — la capsule — dont la capture est cadrée serrée : collé aux bords,
      il remplit la fenêtre comme une capture plein écran alors que c'est une bille
      posée dans le vide. La marge lui redonne son échelle. Une capture d'écran, elle,
      n'en prend jamais : elle EST l'écran. En %, donc la respiration reste la même
      quelle que soit la taille d'affichage. */
  marge?: number;
}
const { titre = 'Field Ops', clair = false, marge = 0 } = Astro.props;
---
<div class:list={['mcw', clair && 'mcw--clair']}>
  <div class="mcw__barre" aria-hidden="true">
    <span class="mcw__feux"><i></i><i></i><i></i></span>
    <span class="mcw__titre">{titre}</span>
  </div>
  <div class:list={['mcw__corps', marge && 'mcw__corps--marge']} style={marge ? `padding:${marge}%` : undefined}><slot /></div>
</div>

<style>
  .mcw {
    border: 1px solid #2a2a30;
    border-radius: 12px;
    overflow: hidden;
    background: #101014;
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.45);
  }
  .mcw__barre {
    position: relative;
    display: flex; align-items: center;
    height: 30px; padding: 0 12px;
    background: linear-gradient(#26262c, #1d1d22);
    border-bottom: 1px solid #000;
  }
  .mcw__feux { display: inline-flex; gap: 7px; }
  .mcw__feux i { width: 11px; height: 11px; border-radius: 50%; }
  .mcw__feux i:nth-child(1) { background: #ff5f57; }
  .mcw__feux i:nth-child(2) { background: #febc2e; }
  .mcw__feux i:nth-child(3) { background: #28c840; }
  .mcw__titre {
    position: absolute; left: 50%; transform: translateX(-50%);
    font: 500 11.5px/1 -apple-system, system-ui, sans-serif;
    color: rgba(255, 255, 255, 0.55);
    /* LE TITRE NE DOIT JAMAIS RECOUVRIR LES FEUX. Il est centré en absolu, donc il
       ignore la place que prennent les trois pastilles : dans une fenêtre étroite
       — la capsule sur téléphone, 202 px — « c-brain — capsule » passait à la ligne
       et se posait par-dessus. Il est borné à la largeur libre entre les feux et la
       marge symétrique de droite, et coupé proprement plutôt que replié.
       128 px = les trois feux et leur marge (59 px) comptés DES DEUX CÔTÉS, plus
       10 px de souffle : un titre centré déborde autant à gauche qu'à droite, donc
       la place libre vaut deux fois celle des feux, pas une. */
    max-width: calc(100% - 128px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mcw__corps { display: block; }
  /* Le noir de la fenêtre (#101014) n'est PAS celui de la vidéo (#000) : avec une
     marge, la différence dessine un rectangle et la capture a l'air collée dans la
     fenêtre au lieu d'y vivre. Même noir des deux côtés, la couture disparaît. */
  .mcw__corps--marge { background: #000; }
  .mcw--clair { background: #fff; border-color: #d2d2d8; }
  .mcw--clair .mcw__barre { background: linear-gradient(#f0f0f3, #e3e3e8); border-bottom-color: #cfcfd6; }
  .mcw--clair .mcw__titre { color: rgba(0, 0, 0, 0.6); }
</style>
