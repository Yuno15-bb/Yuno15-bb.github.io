---
/**
 * Flow — une chaine d'etapes, du depart a l'arrivee.
 *
 * Pourquoi en HTML et pas en SVG : une planche SVG ne se replie pas. A 390 px de
 * large elle rétrécit, et son texte de 12 px tombe a 4 px. Ici les etapes passent
 * d'une rangee a une colonne, et le texte garde sa taille de lecture.
 *
 * Le trait qui relie les etapes est le MEME filet que celui qui les souligne : la
 * ligne traverse la planche d'un bout a l'autre, les fleches disent le sens.
 * Une etape marquee `porte` est une main humaine dans la chaine — accent ember,
 * la seule couleur du site.
 */
export interface Etape {
  /** Titre court de l'etape. */
  t: string;
  /** Ce qui s'y passe, une ligne. */
  d?: string;
  /** Etape ou une personne intervient : marquee a l'accent. */
  porte?: boolean;
}
interface Props {
  etapes: Etape[];
}
const { etapes } = Astro.props;
const n2 = (i: number) => String(i + 1).padStart(2, '0');
/* Les fleches ont leur PROPRE colonne : une piste etroite entre deux etapes larges.
   Le gabarit se calcule ici parce que CSS ne sait pas repeter un motif un nombre
   variable de fois sans connaitre le compte. Il passe par une variable, jamais par
   `grid-template-columns` en ligne — sinon la regle mobile ne pourrait plus le
   remplacer, un style en ligne gagnant sur la feuille. */
const cols = '1fr' + ' auto 1fr'.repeat(Math.max(0, etapes.length - 1));
---
<ol class="flow" role="list" style={`--flow-cols:${cols}`}>
  {etapes.map((e, i) => (
    <>
      <li class:list={['flow__step', e.porte && 'flow__step--porte']}>
        <span class="flow__n">{n2(i)}</span>
        <span class="flow__t">{e.t}</span>
        {e.d && <span class="flow__d">{e.d}</span>}
      </li>
      {i < etapes.length - 1 && (
        <li class:list={['flow__lien', etapes[i + 1].porte && 'flow__lien--porte']} aria-hidden="true">
          <span class="flow__fleche"></span>
        </li>
      )}
    </>
  ))}
</ol>

<style>
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: var(--flow-cols, 1fr);
    align-items: start;
    gap: var(--space-3);
  }
  .flow__step {
    position: relative;
    display: grid;
    gap: var(--space-1);
    align-content: start;
    border-top: 1px solid var(--c-line-ui);
    padding-top: var(--space-2);
    min-width: 0;
  }
  /* ── LA FLECHE, MEME GRAMMAIRE QUE LA CARTE DU SYSTEME ──
     L'ancien dessin faisait passer un filet CONTINU d'un bout a l'autre, avec une
     pointe de 6 px coincee dans l'ecart : de loin ca ne se lit pas comme des
     fleches mais comme une seule ligne, et le sens de lecture disparait. Ici la
     fleche a sa propre colonne, elle est large, elle pointe. C'est le dessin que
     Dylan a retenu sur la carte du systeme (2026-09-07) — les deux planches de la
     page parlent donc la meme langue.
     Elle est posee sous le filet de l'etape, a hauteur du numero : au ras du filet
     elle le prolongerait, et on retomberait sur la ligne continue. */
  .flow__lien {
    display: block;
    width: 3.5rem;
    padding-top: var(--space-3);
  }
  .flow__fleche {
    display: block;
    position: relative;
    width: 100%;
    height: 1px;
    background: var(--c-line-ui);
  }
  .flow__fleche::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3.5px;
    border-left: 6px solid var(--c-line-ui);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }
  /* La fleche qui ENTRE dans l'etape humaine porte deja son accent : l'oeil suit le
     passage garde avant meme de lire le titre. */
  .flow__lien--porte .flow__fleche { background: var(--c-ember); }
  .flow__lien--porte .flow__fleche::after { border-left-color: var(--c-ember); }

  .flow__n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--c-muted) 80%, transparent);
  }
  .flow__t {
    font-size: var(--fs-200);
    color: var(--c-fg);
    line-height: 1.3;
  }
  .flow__d {
    font-size: var(--fs-100);
    color: var(--c-muted);
    line-height: 1.5;
  }

  /* L'etape humaine : c'est la decision d'architecture du projet, elle se voit. */
  .flow__step--porte { border-top-width: 2px; border-top-color: var(--c-ember); padding-top: calc(var(--space-2) - 1px); }
  .flow__step--porte .flow__n,
  .flow__step--porte .flow__t { color: var(--c-ember); }

  /* Sous 760 px la rangee devient une colonne : chaque etape garde sa taille de
     lecture, et la fleche bascule a la verticale plutot que de disparaitre — c'est
     elle qui dit que les etapes s'enchainent, pas juste qu'elles se suivent. */
  @media (max-width: 760px) {
    .flow { grid-template-columns: 1fr; gap: var(--space-2); }
    .flow__lien { width: auto; padding: var(--space-1) 0 var(--space-1) var(--space-2); }
    .flow__fleche { width: 1px; height: var(--space-4); }
    .flow__fleche::after {
      right: auto; top: auto; left: -3.5px; bottom: 0;
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 6px solid var(--c-line-ui);
      border-bottom: 0;
    }
    .flow__lien--porte .flow__fleche::after { border-top-color: var(--c-ember); }
  }
</style>
