---
/**
 * Appareils — le même écran du produit, au même instant, sur Mac, iPad et iPhone.
 *
 * REMPLACE `Ecrans.astro` (cadres dessinés en CSS) pour les projets d'apps Apple. Deux règles
 * d'Apple, relues le 2026-09-17, commandent cette figure :
 *   · « Use Apple-provided product bezels » — les cadres sont les images officielles d'Apple
 *     (Apple Design Resources), posées telles quelles. Un iPhone redessiné en CSS est une
 *     imitation au sens des App Store Marketing Guidelines.
 *   · « Maintain the correct relative product scale whenever multiple products are shown ».
 *
 * UNE SEULE IMAGE, pas trois. La première version posait les trois appareils côte à côte en CSS,
 * avec des pourcentages : l'espacement dérivait et l'iPhone ne s'alignait plus (vu par Dylan le
 * 17/09 sur la page en ligne). La planche est maintenant assemblée au pixel près par
 * `cadres.py`, qui range les appareils par leur SILHOUETTE : 2,5 mm entre le Mac et l'iPad,
 * 8,6 mm entre l'iPad et l'iPhone, bas alignés, tailles réelles. Rien ne peut plus glisser ici.
 *
 * Fond transparent : le champ de particules du site reste visible derrière les appareils, comme
 * l'exige la direction « Champ spatial » (aucun aplat opaque).
 *
 * Fabrication : ~/Desktop/DG CHARPENTE/presentation-apple/ (capturer.mjs + assembler.py).
 */
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---
<img class="appareils" src={src} alt={alt} loading="lazy" decoding="async" />

<style>
  .appareils {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
