---
/**
 * Systeme — la carte des grandes parties, et ce qui passe entre elles.
 *
 * DIFFÉRENT DE Flow, ET C'EST LE POINT. Flow raconte un TRAJET : une chose part
 * d'un bout et arrive à l'autre. Ici on montre des PARTIES qui coexistent, et
 * surtout la RÈGLE qui gouverne chaque passage — c'est la règle qui explique
 * l'architecture, pas la boîte. Un schéma qui ne montrerait que quatre cases
 * reliées par des flèches identiques serait une liste déguisée : il ne dirait
 * rien de plus que le sommaire. (cf. Brain : un-seul-diagramme-ne-documente-pas-
 * un-systeme-entier — une planche, une mécanique.)
 *
 * En HTML et pas en SVG, pour la même raison que Flow : à 390 px une planche SVG
 * rétrécit son texte jusqu'à l'illisible, là où des colonnes se replient en lignes.
 */
export interface Partie {
  /** Nom court de la partie. */
  nom: string;
  /** Ce qu'elle contient — deux ou trois éléments, pas l'inventaire. */
  items: string[];
  /** Ce qui la relie à la SUIVANTE, et la règle qui gouverne ce passage. */
  lien?: string;
  /** Passage gardé par une règle stricte — file d'attente, main humaine. Accent. */
  garde?: boolean;
}
interface Props {
  parties: Partie[];
}
const { parties } = Astro.props;
---
<div class="sys">
  {parties.map((p, i) => (
    <>
      <section class="sys__part">
        <h4 class="sys__nom eyebrow">{p.nom}</h4>
        <ul role="list" class="sys__list">
          {p.items.map((it) => <li>{it}</li>)}
        </ul>
      </section>
      {p.lien && i < parties.length - 1 && (
        <p class:list={['sys__lien', p.garde && 'sys__lien--garde']}>
          <span class="sys__fleche" aria-hidden="true"></span>
          <span class="sys__regle">{p.lien}</span>
        </p>
      )}
    </>
  ))}
</div>

<style>
  .sys {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }
  .sys__part {
    min-width: 0;
    border-top: 1px solid var(--c-line-ui);
    padding-top: var(--space-2);
    display: grid;
    gap: var(--space-2);
  }
  .sys__nom { color: var(--c-fg); margin: 0; }
  .sys__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--space-1);
    color: var(--c-muted); font-size: var(--fs-100); line-height: 1.5;
  }
  /* Le lien n'est pas une flèche muette : il PORTE la règle du passage, et c'est
     elle qu'on doit pouvoir lire seule. */
  .sys__lien {
    margin: 0;
    max-width: 9rem;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding-top: var(--space-2);
    text-align: center;
  }
  .sys__fleche {
    display: block; width: 100%; height: 1px;
    background: var(--c-line-ui); position: relative;
  }
  .sys__fleche::after {
    content: ''; position: absolute; right: 0; top: -3.5px;
    border-left: 6px solid var(--c-line-ui);
    border-top: 4px solid transparent; border-bottom: 4px solid transparent;
  }
  .sys__regle { color: var(--c-muted); font-size: var(--fs-100); line-height: 1.4; }
  .sys__lien--garde .sys__fleche { background: var(--c-ember); }
  .sys__lien--garde .sys__fleche::after { border-left-color: var(--c-ember); }
  .sys__lien--garde .sys__regle { color: var(--c-ember); }

  /* Sous 900 px il n'y a plus de « à côté » : les parties s'empilent et la règle
     du passage se lit entre deux, la flèche à la verticale. */
  @media (max-width: 900px) {
    .sys { grid-template-columns: 1fr; gap: var(--space-2); }
    .sys__lien { max-width: none; justify-items: start; text-align: left; padding: var(--space-1) 0; }
    .sys__fleche { width: 1px; height: var(--space-4); margin-left: var(--space-2); }
    .sys__fleche::after {
      right: auto; top: auto; left: -3.5px; bottom: 0;
      border-left: 4px solid transparent; border-right: 4px solid transparent;
      border-top: 6px solid var(--c-line-ui); border-bottom: 0;
    }
    .sys__lien--garde .sys__fleche::after { border-top-color: var(--c-ember); }
  }
</style>
