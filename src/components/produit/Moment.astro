---
/**
 * Moment — une démonstration filmée : le texte à gauche, la vidéo à droite.
 * Jamais d'alternance gauche/droite : un seul bord gauche par écran.
 */
interface Props { surtitre?: string; titre: string; badge?: string; }
const { surtitre, titre, badge } = Astro.props;
---
<div class="moment" data-apparait>
  <div class="moment__texte">
    {surtitre && <p class="p-surtitre">{surtitre}</p>}
    <h3 class="moment__titre">{titre}</h3>
    {badge && <p class="moment__badge">{badge}</p>}
    <slot name="texte" />
  </div>
  <div class="moment__visuel"><slot /></div>
</div>

<style>
  .moment {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--e-48);
    align-items: center;
  }
  .moment + .moment { margin-top: var(--e-48); padding-top: var(--e-48); border-top: 1px solid var(--p-filet); }
  .moment__titre { font-size: var(--t-titre3); line-height: 1.15; letter-spacing: -0.02em; }
  .moment__badge {
    display: inline-block; margin: var(--e-12) 0 0;
    padding: var(--e-2) var(--e-12);
    border-radius: 999px; border: 1px solid var(--p-filet-fort);
    font-family: var(--font-mono); font-size: var(--t-legende); color: var(--p-doux);
  }
  .moment__texte :global(p) { margin-top: var(--e-16); color: var(--p-doux); }
  /* Les cadres d'écran gardent leur borne (--ecran-echelle, Dylan 25/09) : ici la
     colonne est plus étroite qu'elle, ils la remplissent. */
  .moment__visuel { min-width: 0; }
  @media (max-width: 900px) {
    .moment { grid-template-columns: minmax(0, 1fr); gap: var(--e-24); }
  }
</style>
