---
/**
 * FondAnime — le fond animé du site. Il REMPLACE le champ d'étoiles.
 *
 * C'est l'ambiance « Prism » du catalogue de Dylan
 * (Desktop/UI Components/ASSETS/Gradient Background Animation) : un shader WebGL2
 * — le shader `warp` de @paper-design/shaders, licence MIT — que Framer emballait
 * dans un composant. Le moteur est celui du catalogue, recopié tel quel dans
 * `public/vendor/` : le corriger ici et là-bas ferait diverger deux copies.
 *
 * DEUX ÉCARTS AVEC L'AMBIANCE D'ORIGINE, demandés le 2026-09-07 :
 *   · PLUS LENTE — vitesse 30 → 10. Un fond qui bouge vite attire l'œil et vole la
 *     lecture ; à 10 la matière respire sans jamais réclamer l'attention.
 *   · PLUS INTENSE — bords plus nets (softness 47 → 30) et tourbillon poussé
 *     (50 → 62). Les couleurs restent celles de l'ambiance.
 *
 * TROIS CHOIX DE PERFORMANCE, pris après mesure et pas par principe :
 *   · le champ d'étoiles est retiré (deux boucles WebGL se disputaient la carte) ;
 *   · les couches de tourbillon passent de 16 à 8 — c'est le réglage qui coûte le
 *     plus cher, chaque couche étant une passe de bruit PAR PIXEL ;
 *   · la densité de pixels est plafonnée à 1 : sur un dégradé mou, le 2× d'un écran
 *     retina quadruple le travail sans que l'œil y gagne quoi que ce soit.
 *
 * ET L'INTENSITÉ EST DANS LES COULEURS, PAS DANS UNE OPACITÉ. Un voile en `opacity`
 * sur un plein écran force le navigateur à composer deux couches à chaque image.
 * Assombrir directement les couleurs données au shader donne le même rendu sans
 * cette couche de plus. cf. Brain : webgl-shader-wallpaper-gpu-overheating.
 *
 * LE VOILE N'EST PAS DE LA TIMIDITÉ. Le corps de texte du site se lit DIRECTEMENT
 * sur ce fond — pas de carte opaque, c'est la règle de la direction artistique. Un
 * vert vif plein écran ferait tomber le contraste du texte sous le seuil lisible.
 * Le voile sombre garde l'intensité de la matière tout en rendant le texte lisible.
 */
interface Props {
  /** Force de la matière, 0 à 1 : elle assombrit les couleurs du shader plutôt que
      de poser un voile par-dessus. */
  intensite?: number;
  /** La même force, sur un écran étroit. Voir le bloc « LE TÉLÉPHONE » ci-dessous. */
  intensiteEtroit?: number;
}
const { intensite = 0.72, intensiteEtroit = 0.42 } = Astro.props;

/** Assombrit une couleur au prorata — l'intensité entre DANS le shader. */
const teinte = (hex: string, k: number) => {
  const n = parseInt(hex.slice(1), 16);
  const c = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => Math.round(v * k));
  return '#' + c.map((v) => v.toString(16).padStart(2, '0')).join('');
};
const palette = (k: number) => ({
  color1: teinte('#050505', 1),
  color2: teinte('#66B3FF', k),
  /* Le blanc de l'ambiance est le vrai danger pour la lecture : c'est lui qui fait
     monter les bandes jusqu'à 236 sur 255, là où un titre blanc disparaît. Il est
     tenu bas — la bande reste lumineuse, elle cesse d'être un mur blanc. */
  color3: teinte('#FFFFFF', k * 0.42),
});
const couleurs = palette(intensite);
/* ============================================================
   LE TÉLÉPHONE REÇOIT LA MÊME MATIÈRE, PLUS SOMBRE — mesure du 19/09.
   Les bandes claires ne sont pas plus nombreuses sur un téléphone : elles
   couvrent 17 à 24 % de l'écran, contre 16 à 31 % sur le bureau. Ce qui change,
   c'est OÙ elles tombent. Sur le bureau la colonne de texte occupe 15 % de
   l'écran, perdue au milieu d'un grand canevas : une bande passe à côté. Sur un
   téléphone elle en occupe 40 %, bord à bord — une bande qui traverse l'écran
   traverse forcément le texte. Mesuré sur la page Field Ops : 27,7 % de la
   surface de texte tombait sous 4,5:1 pour le gris courant, contre 21,3 % sur
   le bureau.
   On n'ajoute donc PAS un voile par-dessus le champ — la règle de la direction
   l'interdit, et une couche de plus se compose à chaque image. On assombrit les
   couleurs données au shader, exactement comme le fait déjà l'intensité : même
   matière, même mouvement, moins de lumière là où il n'y a pas la place de
   l'éviter.
   ============================================================ */
const couleursEtroit = palette(intensiteEtroit);
---
<div class="fond-anime" aria-hidden="true" data-couleurs={JSON.stringify(couleurs)} data-couleurs-etroit={JSON.stringify(couleursEtroit)}>
  <div class="fond-anime__gbg"></div>
</div>

<style>
  .fond-anime {
    position: fixed;
    inset: 0;
    /* Sous le champ d'étoiles (-2) et sous tout le contenu. */
    z-index: -3;
    pointer-events: none;
    background: var(--c-bg);
  }
  .fond-anime__gbg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  /* LE MOTEUR CRÉE SA PROPRE BOÎTE. `create()` insère un `<div class="gbg">` dans
     le point de montage et c'est LUI qu'il mesure — pas mon conteneur. Sans règle
     de taille (la feuille du catalogue n'est pas chargée ici), cette boîte prend la
     hauteur de son contenu : le canevas est sorti à 720 px pour une fenêtre de 900,
     et le bas de la page restait uni. Mesuré, pas supposé. */
  .fond-anime__gbg :global(.gbg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: transparent;
  }
  .fond-anime__gbg :global(.gbg__canvas) { display: block; width: 100%; height: 100%; }
</style>

<script>
  const hote = document.querySelector<HTMLElement>('.fond-anime');
  const cible = hote?.querySelector<HTMLElement>('.fond-anime__gbg');
  if (hote && cible) {
    const charger = (src: string) =>
      new Promise<void>((ok, ko) => {
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => ok();
        s.onerror = () => ko(new Error(src));
        document.head.appendChild(s);
      });

    /* Le shader d'abord, le moteur ensuite : sans `window.WARP_GLSL` le moteur
       lève une erreur claire plutôt que de peindre du noir. */
    charger('/vendor/gradient-background/warp-shader.js')
      .then(() => charger('/vendor/gradient-background/gradient-background.js'))
      .then(() => {
        const G = (window as any).GradientBackground;
        if (!G) return;
        /* Le HTML est le même pour toutes les largeurs : c'est ici, au montage, que
           l'écran étroit choisit sa palette. 720 px est la borne déjà utilisée par le
           reste du site pour « téléphone ». */
        const etroit = matchMedia('(max-width: 720px)').matches;
        const couleurs = JSON.parse(
          (etroit ? hote.dataset.couleursEtroit : hote.dataset.couleurs) || '{}',
        );
        const api = G.create(cible, {
          preset: 'Prism',
          ...couleurs,
          /* Dylan, 18/09 : « améliore la qualité du fond et fais-le défiler un peu plus
             vite ». Trois valeurs remontent, et aucune ne revient à l'ambiance d'origine —
             celle-ci faisait chauffer le GPU (cf. Brain : webgl-shader-wallpaper-gpu-overheating). */
          speed: 18,            // 10 depuis le 07/09, 30 dans l'ambiance d'origine
          softness: 30,         // 47 — des bords plus nets, donc plus de présence
          swirl: 62,            // 50
          swirlIterations: 12,  // 8 — c'est le réglage le plus cher du shader ; 16 à l'origine
          /* Le vrai responsable du flou : à 1, un écran dense affiche un pixel du shader
             pour quatre pixels réels, et les dégradés se rayent. 1,5 supprime les raies
             pour la moitié du coût d'un rendu plein 2×. */
          maxPixelRatio: 1.5,
        });
        /* « Réduire les animations » : la matière reste, elle cesse de bouger.
           Un fond qui coule en continu est exactement ce que ce réglage refuse. */
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          setTimeout(() => api.stop && api.stop(), 120);
        }
      })
      .catch(() => { /* pas de WebGL2, ou fichier absent : la nuit du site reste. */ });
  }
</script>
