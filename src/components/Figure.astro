---
/**
 * Figure — la « planche » du site.
 *
 * Direction « Champ spatial » : une figure n'est pas une carte posee SUR le fond,
 * c'est un cadre de filets DANS lequel le champ de particules reste visible.
 * Aucun aplat opaque, aucun coin arrondi, aucune ombre portee (cf tokens.css,
 * regle « RIEN ne recouvre le champ »).
 *
 * La largeur est portee par la mise en page de l'article (`.project__body` place
 * les `figure` de `text-start` a `full-end`) : le composant ne fixe aucune largeur.
 */
interface Props {
  /** Surtitre mono, court — ce que la planche montre. */
  titre?: string;
  /** Legende sous la planche : la phrase a retenir, en francais courant. */
  legende?: string;
  /** Mention de provenance (donnees reconstruites, capture, etc.). */
  source?: string;
  /** Cadre autour de la planche. À mettre à false quand le contenu porte déjà
      son propre contour — une maquette d'appareil, par exemple : sinon on voit
      deux rectangles emboîtés. */
  cadre?: boolean;
}
const { titre, legende, source, cadre = true } = Astro.props;
---
<figure class="fig">
  {titre ? (
    /* LA PLANCHE SE REPLIE SUR TÉLÉPHONE — voir le bloc de style plus bas.
       `<details open>` : elle est OUVERTE partout, y compris sans JavaScript, y compris
       pour un moteur de recherche. Seul un script, et seulement sous 720 px, lui retire
       son `open`. Le repli est donc un bonus d'écran étroit, jamais une condition pour
       accéder au contenu.
       On ne replie que ce qui a un SURTITRE : sans titre, une planche fermée serait une
       boîte muette qu'on n'ouvre pas parce qu'on ignore ce qu'elle contient. */
    <details class="fig__repli" open>
      <summary class="fig__resume">
        <span class="fig__kicker eyebrow">{titre}</span>
        <span class="fig__chevron" aria-hidden="true"></span>
      </summary>
      <div class:list={['fig__plate', !cadre && 'fig__plate--nu']}><slot /></div>
    </details>
  ) : (
    <div class:list={['fig__plate', !cadre && 'fig__plate--nu']}><slot /></div>
  )}
  {(legende || source) && (
    <figcaption class="fig__cap">
      {legende}
      {source && <span class="fig__source">{source}</span>}
    </figcaption>
  )}
</figure>

<style>
  .fig {
    margin: var(--space-8) 0;
    display: grid;
    gap: var(--space-2);
  }
  .fig__kicker { color: var(--c-ember); }
  /* Le cadre : un filet, du vide, rien d'opaque. */
  .fig__plate {
    border: 1px solid var(--c-line);
    padding: var(--space-4);
  }
  .fig__plate--nu { border: 0; padding: 0; }
  .fig__cap {
    color: var(--c-muted);
    font-size: var(--fs-100);
    line-height: 1.5;
    max-width: 62ch;
  }
  .fig__source {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* ⚠ Etait a 70 % d'opacite : 3.91:1, sous le seuil WCAG de 4.5:1 pour un
       texte de 11 px. Mesure, pas suppose. Le jeton plein donne 6.96:1. */
    color: var(--c-muted);
  }
  @media (max-width: 720px) {
    .fig { margin: var(--space-6) 0; }
    .fig__plate { padding: var(--space-3); }
    .fig__plate--nu { padding: 0; }
  }

  /* ============================================================
     SUR TELEPHONE, LE CADRE S'OUVRE SUR LES COTES — mesure du 19/09.
     Le cadre coutait 24 px de marge A GAUCHE ET A DROITE a l'interieur d'une
     colonne qui n'en a que 329. Dans une planche qui porte elle-meme un filet
     — le recit d'incident — il restait 262 px de texte, soit 25 signes par
     ligne : une ligne de quatre mots, qu'on relit plus qu'on ne la lit.
     Pour comparer, mesure le meme jour sur quatre sites de lecture longue a
     393 px : MDN 353 px de colonne et 37,8 signes par ligne, web.dev 361 px et
     42,5, Smashing Magazine 332 px et 38,6, Nielsen Norman Group 413 px et
     46,9. Aucun ne descend sous 37. Le portfolio etait a 25.
     Les filets du haut et du bas RESTENT : la planche garde son cadre, elle
     cesse seulement de le payer sur les cotes, la ou l'ecran est compte. Le
     cadre d'appareil d'une maquette, lui, n'a jamais eu ce probleme — il porte
     son propre contour et passe deja par `--nu`.
     ============================================================ */
  @media (max-width: 480px) {
    .fig__plate { padding-inline: 0; border-inline: 0; }
  }

  /* ============================================================
     LE REPLI DES PLANCHES SUR TÉLÉPHONE — Dylan, 18/09 : « dès que tu rentres dans
     un projet c'est vite illisible et trop volumineux ».

     CE QUE LA MESURE DISAIT. Field Ops, 393 px : 19 486 px de page, soit 22,9 écrans.
     Les onze planches en prenaient 12 856, c'est-à-dire 66 % de la page — et ce ne
     sont PAS des images : dix sur onze sont du texte, des schémas et des récits de
     panne de 100 à 280 mots. Sur le bureau ils tiennent en colonnes ; sur téléphone
     chaque colonne devient une tour d'un à deux écrans. Le texte courant, lui, ne
     pesait que 3 558 px, 18 % de la page. Ce n'est donc pas l'écriture qui est trop
     longue, c'est la mise en page qui se déplie à la verticale.

     SUR LE BUREAU RIEN NE CHANGE. Le triangle du navigateur est retiré, le chevron
     est caché, et `<summary>` reprend exactement l'allure du surtitre d'avant. Une
     planche ouverte est indiscernable de ce qu'elle était.
     ============================================================ */
  .fig__repli { display: contents; }
  .fig__resume { display: contents; cursor: default; }
  .fig__resume::-webkit-details-marker { display: none; }
  .fig__resume::marker { content: ''; }
  .fig__chevron { display: none; }

  @media (max-width: 720px) {
    /* Le résumé redevient une vraie ligne cliquable, avec le chevron à droite.
       44 px de haut : c'est la cible tactile minimale d'Apple comme de Google. */
    .fig__repli { display: block; }
    .fig__resume {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      min-height: 44px;
      cursor: pointer;
      list-style: none;
      border-block: 1px solid var(--c-line);
      padding-block: var(--space-1);
    }
    .fig__resume .fig__kicker { margin: 0; }
    /* Le chevron est dessiné, pas écrit : un caractère « ▾ » change de dessin d'une
       police à l'autre et ne tourne pas proprement. */
    .fig__chevron {
      display: block;
      flex: none;
      width: 9px; height: 9px;
      border-right: 1.5px solid var(--c-ember);
      border-bottom: 1.5px solid var(--c-ember);
      transform: translateY(-2px) rotate(45deg);
      transition: transform var(--dur-micro) var(--ease-out);
    }
    .fig__repli[open] .fig__chevron { transform: translateY(2px) rotate(225deg); }
    /* Fermée, la planche ne laisse pas le filet du bas du résumé coller au bloc suivant. */
    .fig__repli:not([open]) { margin-bottom: var(--space-2); }
    .fig__repli[open] .fig__plate { margin-top: var(--space-3); }
  }
</style>

<script>
  /* LE REPLI EST UN GESTE D'ÉCRAN ÉTROIT, PAS UNE RÈGLE DU DOCUMENT.
     Le HTML sort `open` : sans JavaScript, sans CSS, pour un moteur de recherche ou un
     lecteur d'écran, la planche est ouverte et le contenu est là. C'est seulement ici,
     sous 720 px, qu'on la referme — et une seule fois, au chargement. Rouvrir en tournant
     le téléphone en paysage effacerait ce que le lecteur vient d'ouvrir à la main.
     La première planche titrée de la page reste OUVERTE : arriver sur une suite de boîtes
     closes ne dit pas ce qu'on peut en attendre ; une d'ouverte montre la nature du
     contenu, les suivantes se replient. */
  if (matchMedia('(max-width: 720px)').matches) {
    const plis = document.querySelectorAll<HTMLDetailsElement>('.fig__repli');
    plis.forEach((d, i) => { if (i > 0) d.open = false; });
  }
</script>
