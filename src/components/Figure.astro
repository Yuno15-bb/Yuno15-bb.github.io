---
/**
 * Figure — la « planche » du site.
 *
 * Direction « Champ spatial » : une figure n'est pas une carte posee SUR le fond,
 * c'est un cadre de filets DANS lequel le champ de particules reste visible.
 * Aucun aplat opaque, aucun coin arrondi, aucune ombre portee (cf tokens.css,
 * regle « RIEN ne recouvre le champ »).
 *
 * La largeur est portee par la mise en page de l'article (`.project__body` place
 * les `figure` de `text-start` a `full-end`) : le composant ne fixe aucune largeur.
 */
interface Props {
  /** Surtitre mono, court — ce que la planche montre. */
  titre?: string;
  /** Legende sous la planche : la phrase a retenir, en francais courant. */
  legende?: string;
  /** Mention de provenance (donnees reconstruites, capture, etc.). */
  source?: string;
  /** Cadre autour de la planche. À mettre à false quand le contenu porte déjà
      son propre contour — une maquette d'appareil, par exemple : sinon on voit
      deux rectangles emboîtés. */
  cadre?: boolean;
}
const { titre, legende, source, cadre = true } = Astro.props;
---
<figure class="fig">
  {titre && <p class="fig__kicker eyebrow">{titre}</p>}
  <div class:list={['fig__plate', !cadre && 'fig__plate--nu']}><slot /></div>
  {(legende || source) && (
    <figcaption class="fig__cap">
      {legende}
      {source && <span class="fig__source">{source}</span>}
    </figcaption>
  )}
</figure>

<style>
  .fig {
    margin: var(--space-8) 0;
    display: grid;
    gap: var(--space-2);
  }
  .fig__kicker { color: var(--c-ember); }
  /* Le cadre : un filet, du vide, rien d'opaque. */
  .fig__plate {
    border: 1px solid var(--c-line);
    padding: var(--space-4);
  }
  .fig__plate--nu { border: 0; padding: 0; }
  .fig__cap {
    color: var(--c-muted);
    font-size: var(--fs-100);
    line-height: 1.5;
    max-width: 62ch;
  }
  .fig__source {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* ⚠ Etait a 70 % d'opacite : 3.91:1, sous le seuil WCAG de 4.5:1 pour un
       texte de 11 px. Mesure, pas suppose. Le jeton plein donne 6.96:1. */
    color: var(--c-muted);
  }
  @media (max-width: 720px) {
    .fig { margin: var(--space-6) 0; }
    .fig__plate { padding: var(--space-3); }
    .fig__plate--nu { padding: 0; }
  }

  /* ============================================================
     SUR TELEPHONE, LE CADRE S'OUVRE SUR LES COTES — mesure du 19/09.
     Le cadre coutait 24 px de marge A GAUCHE ET A DROITE a l'interieur d'une
     colonne qui n'en a que 329. Dans une planche qui porte elle-meme un filet
     — le recit d'incident — il restait 262 px de texte, soit 25 signes par
     ligne : une ligne de quatre mots, qu'on relit plus qu'on ne la lit.
     Pour comparer, mesure le meme jour sur quatre sites de lecture longue a
     393 px : MDN 353 px de colonne et 37,8 signes par ligne, web.dev 361 px et
     42,5, Smashing Magazine 332 px et 38,6, Nielsen Norman Group 413 px et
     46,9. Aucun ne descend sous 37. Le portfolio etait a 25.
     Les filets du haut et du bas RESTENT : la planche garde son cadre, elle
     cesse seulement de le payer sur les cotes, la ou l'ecran est compte. Le
     cadre d'appareil d'une maquette, lui, n'a jamais eu ce probleme — il porte
     son propre contour et passe deja par `--nu`.
     ============================================================ */
  @media (max-width: 480px) {
    .fig__plate { padding-inline: 0; border-inline: 0; }
  }
</style>
