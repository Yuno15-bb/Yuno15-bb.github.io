---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
  titre: string;
  pitch: string;
  audience: string[];
  annee: number;
  contexte?: string;   // « Projet client · anonymisé » : dit ce qu'est le projet, là où
                       // le public (« business ») ne disait rien au visiteur
  cover?: string;      // chemin image dans /public — active la carte "media"
  cover2?: string;     // seconde maquette, posee A COTE de la premiere (diptyque)
  coverEntier?: boolean; // montrer la vignette EN ENTIER (aucun rognage, aucun voile)
  tilt?: number;       // rotationFactor du tilt 3D (0 = pas de tilt)
}
const { lang, slug, titre, pitch, audience, annee, contexte, cover, cover2, coverEntier = false, tilt = 0 } = Astro.props;
const tiltAttrs = tilt > 0 ? { 'data-tilt': String(tilt), 'data-tilt-reverse': '' } : {};
---
<a
  class:list={['card', { 'card--media': cover }]}
  href={`/${lang}/projects/${slug}`}
  data-audience={audience.join(' ')}
  {...tiltAttrs}
>
  {cover && (
    <div class="card__cover">
      {/* Deux cas, deux cadrages. Un DIPTYQUE (telephone + bureau) garde les
          rognages d'origine ; une couverture SEULE est un ecran large qui prend
          toute la carte — sans ce cas, elle heritait du rognage portrait du
          telephone et se retrouvait ecrasee. */}
      {cover2 ? (
        <>
          <img class="shot shot--phone" src={cover} alt="" loading="lazy" decoding="async" width="300" height="627" />
          <img class="shot shot--office" src={cover2} alt="" loading="lazy" decoding="async" width="720" height="608" />
        </>
      ) : (
        <img class:list={['shot', 'shot--seul', coverEntier && 'shot--entier']} src={cover} alt="" loading="lazy" decoding="async" width="1100" height="464" />
      )}
    </div>
  )}
  <div class="card__meta eyebrow">
    <span>{annee}</span>
    <span>{contexte ?? audience.join(' · ')}</span>
  </div>
  <h3 class="card__title">{titre}</h3>
  <p class="card__pitch">{pitch}</p>
  <span class="card__go" aria-hidden="true">→</span>

  <style>
    .card {
      position: relative;
      display: grid;
      /* UNE colonne tenue à la largeur de la carte. Mesure du 25/09 : la vignette (boîte à
         rapport fixe) réclamait une largeur tirée de la HAUTEUR de la carte ; quand
         l'accroche passait sur plus de lignes, la colonne débordait de 9 px et la carte de
         gauche se décalait de sa voisine. `minmax(0, 1fr)` coupe ce calcul. */
      grid-template-columns: minmax(0, 1fr);
      /* Les lignes aussi sont tenues. Les deux cartes d'une rangée ont la même hauteur ; la
         plus courte répartissait son vide entre TOUTES ses lignes (5 px chacune), et son
         titre tombait plus bas que celui de sa voisine. Le vide va à l'accroche seule
         (1fr), la flèche reste en bas. Ordre : vignette, méta, titre, accroche, flèche. */
      grid-template-rows: auto auto 1fr auto;
      gap: var(--space-2);
      /* padding CONSTANT : plus aucun décalage du texte au survol */
      padding: var(--space-4) var(--space-3) var(--space-4) 0;
      border-top: 2px solid var(--c-fg);
      transition: border-color var(--dur-trans) var(--ease-out);
    }
    /* le contenu reste au-dessus de la carte pendant le tilt 3D */
    .card > * { position: relative; z-index: 1; }

    /* LA NAPPE FLOUTÉE DU SURVOL A ÉTÉ RETIRÉE le 25/09 : c'était du verre sur une carte
       de contenu, ce que la base Landmarks interdit (le verre ne porte que la navigation). */

    /* Le filet du haut passe a l'accent : le seul signal de survol necessaire. */
    .card:hover, .card:focus-visible { border-color: var(--c-ember); }
    .card:hover .card__go { color: var(--c-ember); transform: translateX(6px); }

    @media (prefers-reduced-motion: reduce) {
      .card:hover .card__go { transform: none; }
    }
    /* Écart minimum : sur téléphone, « 2026 » touchait « PERSONAL PROJECT · OPEN SOURCE »
       (mesure du 25/09 à 393 px) — `space-between` ne garantit rien quand la ligne est pleine. */
    .card__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 var(--space-2); color: var(--c-muted); }
    .card__title {
      /* Le titre de carte doit rester SOUS le titre de section : a fs-600 il
         rivalisait avec lui et la carte se lisait comme une page entiere. */
      font-size: clamp(var(--fs-300), 2vw, var(--fs-500));
      font-family: var(--font-sans);
      font-weight: 600;
      letter-spacing: -0.015em;
    }
    .card__pitch { color: var(--c-muted); }
    .card__go {
      justify-self: end;
      /* Colle la fleche EN BAS de la carte. Mesure du 04/09 : une carte sans
         couverture s'arretait 192 px au-dessus de sa voisine et laissait un trou
         noir dans la grille. La carte occupe maintenant toute la hauteur de sa
         rangee et toutes les fleches se posent sur la meme ligne. */
      margin-top: auto;
      font-size: var(--fs-400);
      color: var(--c-ember);
      transition: transform var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
    }

    /* ---- Carte "media" : image de couverture en tête ---- */
    .card--media { padding-top: var(--space-3); grid-template-rows: auto auto auto 1fr auto; }
    /* Vignette VERTICALE : la maquette telephone, en entier.
       Ni cadre ni fond — le PNG porte sa propre transparence (canal alpha), donc
       le champ de particules passe autour du telephone sans aucun artifice. */
    .card__cover {
      position: relative; z-index: 1;
      display: flex;
      /* HAUTEUR IDENTIQUE POUR TOUTES LES CARTES. Sans elle, chaque carte prend la
         hauteur de son image : une couverture pleine largeur descend plus bas qu'un
         diptyque, et les titres de la rangée ne commencent pas à la même ligne —
         constaté par Dylan sur l'accueil le 2026-09-06. Le rapport est celui de la
         couverture seule, la plus grande des deux mises en page. */
      /* Reglé à 1100/620 le 18/09. Dylan, devant la vignette de C Brain : « centre, agrandi ».
         Un MacBook seul est un rectangle de 1,64 pour 1 ; dans une fenetre de 2,37 pour 1 il est
         bride par la HAUTEUR et ne prend que 61 % de la largeur — c'est ce qui le faisait paraitre
         petit, pas l'image. A 1,77 pour 1 il prend la largeur entiere. Toutes les cartes changent
         ensemble : c'est la condition posee le 06/09, les titres restent sur la meme ligne. */
      aspect-ratio: 1100 / 620;
      /* Les maquettes plus courtes que la boîte se posent au MILIEU, pas en haut :
         collées en haut elles laissaient un trou sous elles. */
      align-items: center;
      /* Les deux maquettes doivent respirer : a --space-2 elles se lisaient comme
         une seule image coupee. --space-4 en fait deux objets distincts. */
      gap: var(--space-4);
      justify-content: flex-start;
      /* léger décrochage 3D : la vignette avance vers l'utilisateur pendant le tilt */
      transform: translateZ(var(--cover-z, 0));
    }
    .shot {
      display: block;
      /* Vignette DEUX FOIS plus petite, et cadree sur la MOITIE SUPERIEURE du
         telephone : c'est la qu'est l'information (en-tete, mission en cours,
         carte). Le bas — actions rapides, barre d'onglets — n'apporte rien a
         cette echelle.
         Le PNG source fait 900x1878 ; sa moitie haute donne un rapport 900/939,
         d'ou l'aspect-ratio ci-dessous. `cover` + `object-position: top` rogne
         donc par le BAS, sans jamais deformer. */
      height: auto;
      object-fit: cover;
      object-position: top center;
      /* Le rognage tombait en plein milieu de la carte satellite : une coupe nette
         se lit comme une image cassee, pas comme un cadrage. Ce degrade fait
         disparaitre le bas dans la nuit — la coupe devient un choix. */
      -webkit-mask-image: linear-gradient(to bottom, #000 68%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 68%, transparent 100%);
      transition: transform var(--dur-trans) var(--ease-out);
    }
    /* Telephone : portrait, moitie haute (rapport 900/939). */
    .shot--phone { width: clamp(112px, 11vw, 146px); aspect-ratio: 300 / 313; }
    /* Bureau : paysage, moitie haute aussi (2160/911) — les deux maquettes
       partagent donc la meme hauteur et la rangee s'aligne toute seule. */
    .shot--office { width: clamp(266px, 26vw, 346px); aspect-ratio: 720 / 304; }
    /* Couverture seule : l'ecran occupe la largeur de la carte. Meme voile bas
       que les autres pour que la coupe reste un choix, pas une image cassee. */
    .shot--seul { width: 100%; height: 100%; aspect-ratio: auto; }
    /* Planche de plusieurs appareils : on la montre EN ENTIER. Le rognage du bas
       coupait l'iPhone, et le voile de nuit n'a pas de sens sur une image qui
       porte déjà sa transparence. */
    .shot--entier { object-fit: contain; object-position: center; -webkit-mask-image: none; mask-image: none; }
    @media (max-width: 700px) {
      /* Sous 700px la rangee etoufferait : on ne garde que le telephone. */
      .shot--office { display: none; }
      /* LA MARGE DE DROITE N'A PLUS DE VOISINE A ECARTER — mesure du 19/09. Les 24 px
         de droite separent deux cartes posees COTE A COTE. Sous 700 px il n'y a plus
         qu'une colonne : ils ne separent plus rien, ils rognent l'accroche a 305 px
         dans une colonne qui en offre 329, soit 29,9 signes par ligne — sous le
         plancher de 30 que le contrôle telephone tient. Rendus, on remonte a 32. */
      .card { padding-right: 0; }
    }
    .card:hover .shot,
    .card:focus-visible .shot { transform: scale(1.04); }

    /* ---- Tilt 3D (fidèle à motion-primitives : rotationFactor + reverse) ---- */
    .card[data-tilt] {
      transform: perspective(900px)
                 rotateX(var(--rx, 0deg))
                 rotateY(var(--ry, 0deg));
      transform-style: preserve-3d;
      transition: transform 0.32s var(--ease-out);
      will-change: transform;
    }
    .card[data-tilt]:hover { --cover-z: 8px; }

    @media (prefers-reduced-motion: reduce) {
      .card[data-tilt] { transform: none; transition: none; }
      .shot { transition: none; }
      .card:hover .card__cover img { transform: none; }
    }
  </style>
</a>

<script>
  // Tilt 3D vanilla — équivalent de <Tilt rotationFactor isRevese> (motion-primitives),
  // sans framer-motion. Le pointeur incline la carte ; "reverse" inverse le sens.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      const factor = parseFloat(el.dataset.tilt || '8') || 8;
      const rev = el.hasAttribute('data-tilt-reverse') ? -1 : 1;
      const set = (rx: number, ry: number) => {
        el.style.setProperty('--rx', rx.toFixed(2) + 'deg');
        el.style.setProperty('--ry', ry.toFixed(2) + 'deg');
      };
      el.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'touch') return; // pas de tilt au doigt
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;   // -0.5 .. 0.5
        const py = (e.clientY - r.top) / r.height - 0.5;
        // bord = ±factor°. rotateX suit l'axe vertical (inversé), rotateY l'axe horizontal.
        set(rev * -py * 2 * factor, rev * px * 2 * factor);
      });
      el.addEventListener('pointerleave', () => set(0, 0));
    });
  }
</script>
